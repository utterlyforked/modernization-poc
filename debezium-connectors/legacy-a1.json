{
  "name": "legacy-a1-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "postgres-legacy-a1",
    "database.port": "5432",
    "database.user": "legacyuser",
    "database.password": "legacypass",
    "database.dbname": "legacy_a1",
    "database.server.name": "legacy_a1",
    "table.include.list": "public.person",
    "plugin.name": "pgoutput",
    "publication.autocreate.mode": "filtered",
    "topic.prefix": "legacy_a1",
    "transforms": "addTenant",
    "transforms.addTenant.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.addTenant.static.field": "tenant_id",
    "transforms.addTenant.static.value": "tenant_a1"
  }
}
