# Self-contained e2e test runner. Pairs with docker-compose.e2e-test.yml and ./test-e2e.sh;
# runs on the compose network so it reaches api:5000 and debezium:8083 directly.
FROM python:3.11-slim

WORKDIR /app
COPY tests/e2e/requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir -r /tmp/requirements-test.txt

COPY pytest.ini /app/pytest.ini
COPY tests/conftest.py /app/tests/conftest.py
COPY tests/e2e/ /app/tests/e2e/

ENV HOME=/tmp TEST_RESULTS_DIR=/results

CMD ["pytest", "tests/e2e", "-v", "--junitxml=/results/junit-e2e.xml", "-p", "no:cacheprovider"]
