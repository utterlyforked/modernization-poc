# Self-contained e2e test runner. Pairs with docker-compose.e2e-test.yml and make test-e2e;
# runs on the compose network so it reaches api:5000 and debezium:8083 directly.
FROM python:3.11-slim

WORKDIR /app
COPY tests/e2e/requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir -r /tmp/requirements-test.txt

COPY pytest.ini /app/pytest.ini
COPY tests/conftest.py /app/tests/conftest.py
COPY tests/e2e/ /app/tests/e2e/

ENV HOME=/tmp TEST_RESULTS_DIR=/results TEST_SUITE=e2e

# `poisons_stack` tests can wedge the pipeline, so scripts/test-e2e.sh runs each on its own fresh stack.
# `destructive` tests need containers stopped between phases; scripts/test-resilience.sh drives those.
CMD ["pytest", "tests/e2e", "-m", "not destructive and not poisons_stack", "-v", "--junitxml=/results/junit-e2e.xml", "-p", "no:cacheprovider"]
