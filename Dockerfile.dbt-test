# Self-contained test runner (pytest + dbt). Pairs with docker-compose.dbt-test.yml,
# which provides a throwaway Postgres built from postgres-init/new_system.sql.
FROM python:3.11-slim

RUN pip install --no-cache-dir dbt-core==1.7.4 dbt-postgres==1.7.4 "protobuf<5.0.0" pytest==8.3.3

WORKDIR /app
COPY dbt-project/ /dbt/
COPY tests/ /app/tests/

# Writable by any uid so the container can run as the host user (keeps ./test-results user-owned)
RUN chmod -R a+rwX /dbt
ENV DBT_PROFILES_DIR=/dbt HOME=/tmp TEST_RESULTS_DIR=/results DBT_LOG_PATH=/tmp/dbt-logs

CMD ["pytest", "tests", "-v", "--junitxml=/results/junit.xml", "-p", "no:cacheprovider"]
